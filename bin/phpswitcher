#!/usr/bin/env bash

set -e

# Define installation directory, falling back to a default.
export PHPSWITCHER_DIR="${PHPSWITCHER_DIR:-$HOME/.phpswitcher}"

# Used when no VERSION file is installed (Composer checkouts, local git).
PHPSWITCHER_VERSION_FALLBACK="0.5.0-dev"

# Helper functions for printing messages
echo_message() {
    # Only print if PHPSWITCHER_QUIET is not set to "true"
    if [ "$PHPSWITCHER_QUIET" != "true" ]; then
        printf "\n\033[0;32m%s\033[0m\n" "$1" >&2
    fi
}

echo_error() {
    # Always print errors to stderr
    printf "\n\033[0;31m%s\033[0m\n" "$1" >&2
}

# Resolve the path of this script, following one symlink when readlink -f is unavailable.
resolve_script_path() {
    local target="$0"
    local resolved=""
    local link

    if command -v readlink >/dev/null 2>&1; then
        resolved=$(readlink -f "$target" 2>/dev/null || true)
    fi

    if [ -z "$resolved" ] && [ -L "$target" ]; then
        link=$(readlink "$target" 2>/dev/null || true)
        if [ -n "$link" ]; then
            case "$link" in
                /*) resolved="$link" ;;
                *) resolved="$(cd "$(dirname "$target")" && pwd)/$link" ;;
            esac
        fi
    fi

    if [ -z "$resolved" ]; then
        resolved="$target"
    fi

    printf '%s\n' "$resolved"
}

# $PHPSWITCHER_DIR/VERSION, then a VERSION file next to the script (or its parent), then the fallback.
resolve_version() {
    local candidate script_path script_dir

    if [ -f "$PHPSWITCHER_DIR/VERSION" ]; then
        tr -d '[:space:]' < "$PHPSWITCHER_DIR/VERSION"
        return 0
    fi

    script_path=$(resolve_script_path)
    script_dir=$(dirname "$script_path")
    for candidate in "$script_dir/VERSION" "$script_dir/../VERSION"; do
        if [ -f "$candidate" ]; then
            tr -d '[:space:]' < "$candidate"
            return 0
        fi
    done

    printf '%s\n' "$PHPSWITCHER_VERSION_FALLBACK"
}

# --- Update Checking ---
check_for_updates() {
    local command_name="${1:-}"
    local cache_file last now current_version latest_version

    if [ "${PHPSWITCHER_NO_UPDATE_CHECK:-}" = "1" ]; then
        return
    fi

    case "$command_name" in
        self-update|version|-v|--version|help|-h|--help|"")
            return
            ;;
        use)
            # Directory hooks call `use --quiet` on every cd.
            if [ "$PHPSWITCHER_QUIET" = "true" ]; then
                return
            fi
            ;;
    esac

    cache_file="$PHPSWITCHER_DIR/update_check"
    if [ -f "$cache_file" ]; then
        last=$(tr -d '[:space:]' < "$cache_file" || true)
        now=$(date +%s)
        if [[ "$last" =~ ^[0-9]+$ ]] && [ $((now - last)) -lt 86400 ]; then
            return
        fi
    fi

    current_version=$(resolve_version)
    latest_version=$(curl -s --max-time 10 https://api.github.com/repos/rawdreeg/phpswitcher/releases/latest | grep 'tag_name' | cut -d '"' -f 4 | sed 's/v//')

    if [ -z "$latest_version" ]; then
        return # Could not fetch latest version
    fi

    mkdir -p "$PHPSWITCHER_DIR" 2>/dev/null || true
    date +%s > "$cache_file" 2>/dev/null || true

    if [ "$current_version" != "$latest_version" ]; then
        echo_message "A new version ($latest_version) of phpswitcher is available! You are on version $current_version. Run 'phpswitcher self-update' to get the latest version."
    fi
}

# --- OS Detection ---
detect_os() {
    OS=""
    case "$OSTYPE" in
      darwin*)  OS="macos" ;;
      linux-gnu*) OS="linux" ;;
      *)
        echo_error "Unsupported operating system: $OSTYPE"
        exit 1
        ;;
    esac
}

# --- Version Detection ---

# Print "X.Y<TAB>platform|require" from a composer.json, preferring config.platform.php.
composer_php_from_file() {
    local file="$1"
    local compact without constraint

    compact=$(tr -d '[:space:]' < "$file")

    if [[ "$compact" =~ \"platform\":[{][^}]*\"php\":\"([^\"]+)\" ]]; then
        constraint="${BASH_REMATCH[1]}"
        if [[ "$constraint" =~ ([0-9]+\.[0-9]+) ]]; then
            printf '%s\tplatform\n' "${BASH_REMATCH[1]}"
            return 0
        fi
    fi

    without=$(printf '%s' "$compact" | sed -E 's/"platform":[{][^}]*[}]//')
    if [[ "$without" =~ \"php\":\"([^\"]+)\" ]]; then
        constraint="${BASH_REMATCH[1]}"
        if [[ "$constraint" =~ ([0-9]+\.[0-9]+) ]]; then
            printf '%s\trequire\n' "${BASH_REMATCH[1]}"
            return 0
        fi
    fi

    return 1
}

# Print "version<TAB>source" for the current directory.
# Order: nearest .php-version, then nearest composer.json, then the global default.
detect_version_info() {
    local dir detected info version kind

    dir="$PWD"
    while [ -n "$dir" ] && [ "$dir" != "/" ]; do
        if [ -f "$dir/.php-version" ]; then
            detected=$(head -n 1 "$dir/.php-version" | tr -d '[:space:]')
            if [ -n "$detected" ]; then
                printf '%s\t.php-version (%s/.php-version)\n' "$detected" "$dir"
                return 0
            fi
        fi
        dir=$(dirname "$dir")
    done

    dir="$PWD"
    while [ -n "$dir" ] && [ "$dir" != "/" ]; do
        if [ -f "$dir/composer.json" ]; then
            if info=$(composer_php_from_file "$dir/composer.json"); then
                version=${info%%$'\t'*}
                kind=${info#*$'\t'}
                printf '%s\tcomposer.json (%s/composer.json, %s)\n' "$version" "$dir" "$kind"
                return 0
            fi
        fi
        dir=$(dirname "$dir")
    done

    if [ -f "$PHPSWITCHER_DIR/default_version" ]; then
        detected=$(tr -d '[:space:]' < "$PHPSWITCHER_DIR/default_version")
        if [ -n "$detected" ]; then
            printf '%s\tglobal default\n' "$detected"
            return 0
        fi
    fi

    return 1
}

# Detect the required PHP version, prioritizing .php-version over composer.json.
detect_version() {
    local info version source

    if ! info=$(detect_version_info); then
        return 1
    fi

    version=${info%%$'\t'*}
    source=${info#*$'\t'}

    case "$source" in
        .php-version*)
            echo_message "Detected target version $version from .php-version file."
            ;;
        composer.json*)
            echo_message "Detected target version $version from composer.json."
            ;;
        "global default")
            echo_message "Using global default version $version."
            ;;
        *)
            echo_message "Detected target version $version."
            ;;
    esac

    printf '%s\n' "$version"
}


# --- Command Implementations ---

command_list_macos() {
    echo_message "Installed PHP Versions (via Homebrew):"

    local installed_php_versions
    installed_php_versions=$(brew list --formula | grep '^php@' || true)

    if [ -z "$installed_php_versions" ]; then
        echo "No PHP versions found."
        return
    fi

    # Determine active version by checking the symlink for 'php'
    local active_version=""
    local php_link
    # Follow the symlink to find out which version is active
    php_link=$(readlink "$(brew --prefix)/bin/php" 2>/dev/null || echo "")
    if [[ "$php_link" =~ php@([0-9]+\.[0-9]+) ]]; then
        active_version="${BASH_REMATCH[1]}"
    fi

    while IFS= read -r formula; do
        local version=${formula#php@}
        if [ "$version" == "$active_version" ]; then
            echo " * $version (active)"
        else
            echo "   $version"
        fi
    done <<< "$installed_php_versions"
}

command_list_linux() {
    echo_message "Installed PHP Versions (via update-alternatives):"

    if ! command -v update-alternatives >/dev/null; then
        echo_error "The 'update-alternatives' command is not available on this system."
        return
    fi

    local alternatives
    alternatives=$(update-alternatives --list php 2>/dev/null || echo "")

    if [ -z "$alternatives" ]; then
        echo "No PHP versions found configured with update-alternatives."
        return
    fi

    # Get the canonical path of the active binary (e.g., /usr/bin/php8.1)
    local active_php_path
    active_php_path=$(readlink -f /etc/alternatives/php 2>/dev/null || echo "")

    (
        # Use a subshell to read each line to avoid issues in loops
        echo "$alternatives" | while IFS= read -r line; do
            local version
            # Extract X.Y version from a path like /usr/bin/phpX.Y
            if [[ "$line" =~ php([0-9]+\.[0-9]+)$ ]]; then
                version="${BASH_REMATCH[1]}"
                if [ "$line" == "$active_php_path" ]; then
                    echo " * $version (active)"
                else
                    echo "   $version"
                fi
            fi
        done
    )
}

command_list() {
    if [ "$OS" = "macos" ]; then
        command_list_macos
    elif [ "$OS" = "linux" ]; then
        command_list_linux
    else
        echo_error "The 'list' command is not supported on this OS."
        exit 1
    fi
}

command_version() {
    echo "phpswitcher version $(resolve_version)"
}

command_self_update() {
    echo_message "Checking for the latest version..."

    # 1. Fetch the latest release artifact URL
    local artifact_url
    artifact_url=$(curl -s --max-time 10 https://api.github.com/repos/rawdreeg/phpswitcher/releases/latest | grep 'browser_download_url.*phpswitcher\.tar\.gz' | cut -d '"' -f 4)

    if [ -z "$artifact_url" ]; then
        echo_error "Could not find the latest release artifact URL. The update failed."
        exit 1
    fi

    local tmp_file
    tmp_file=$(mktemp "${TMPDIR:-/tmp}/phpswitcher.XXXXXXXXXX.tar.gz")

    # 2. Download the artifact
    echo_message "Downloading the latest version..."
    if ! curl -L --fail --max-time 120 --progress-bar -o "$tmp_file" "$artifact_url"; then
        echo_error "Failed to download the latest version. Please try again later."
        rm -f "$tmp_file" # Clean up partial download
        exit 1
    fi

    # 3. Extract the artifact
    echo_message "Installing the latest version..."
    if tar -xzf "$tmp_file" -C "$PHPSWITCHER_DIR" --strip-components=1; then
        rm -f "$tmp_file" # Clean up downloaded tarball
        echo_message "phpswitcher has been updated successfully!"
        # Display the new version
        command_version
    else
        echo_error "Failed to extract the new version. The update failed."
        rm -f "$tmp_file"
        exit 1
    fi
}

command_use_macos() {
    local requested_version="$1"

    # --- Version Auto-Detection ---
    if [ -z "$requested_version" ]; then
        echo_message "Version argument missing, attempting auto-detection..."
        if ! requested_version=$(detect_version); then
            echo_error "PHP version not specified and could not be detected automatically."
            echo "Usage: phpswitcher use [<version>]"
            exit 1
        fi
    fi

    # --- Version Validation ---
    if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
        echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
        exit 1
    fi

    local target_package="php@$requested_version"
    echo_message "Attempting to switch to $target_package..."

    # 1. Check if target version is installed
    if ! brew list "$target_package" >/dev/null 2>&1; then
        echo_error "Target version $target_package does not appear to be installed via Homebrew."
        echo "Please run \`phpswitcher install $requested_version\` first."
        exit 1
    fi
    echo "$target_package is installed."

    # 2. Get all installed PHP versions
    local installed_php_versions
    installed_php_versions=$(brew list --formula | grep '^php@' || true)

    if [ -z "$installed_php_versions" ]; then
        echo_error "No PHP versions found installed via Homebrew."
        exit 1
    fi

    # 3. Unlink all other PHP versions
    echo_message "Unlinking other PHP versions..."
    while IFS= read -r php_version; do
        if [ "$php_version" != "$target_package" ]; then
            echo " - Unlinking $php_version"
            brew unlink "$php_version" || echo "   - Could not unlink $php_version (maybe already unlinked)."
        fi
    done <<< "$installed_php_versions"

    # 4. Link the target PHP version
    echo_message "Linking $target_package..."
    if brew link --force --overwrite "$target_package"; then
        echo "$requested_version" > "$PHPSWITCHER_DIR/active_version"
        echo_message "Successfully switched to $target_package!"
        echo "Changes should take effect immediately. If you experience issues, try restarting your terminal session."
    else
        echo_error "Failed to link $target_package."
        exit 1
    fi
}

command_install_macos() {
    local requested_version="$1"

    # --- Version Auto-Detection (similar to 'use' command) ---
    if [ -z "$requested_version" ]; then
        echo_message "Version argument missing, attempting auto-detection..."
        if ! requested_version=$(detect_version); then
            echo_error "PHP version not specified and could not be detected automatically."
            echo "Usage: phpswitcher install [<version>]"
            exit 1
        fi
    fi

    # --- Version Validation ---
    if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
        echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
        exit 1
    fi

    local target_package="php@$requested_version"

    # Check if the formula exists in the core repository. If not, try the shivammathur/php tap.
    if ! brew info "$target_package" &>/dev/null; then
        echo_message "Formula $target_package not found in Homebrew core."
        echo_message "Attempting to use the shivammathur/php tap for older versions..."

        # Ensure the tap is available.
        if ! brew tap | grep -q "shivammathur/php"; then
            echo_message "Tapping shivammathur/php..."
            brew tap shivammathur/php
        fi

        # Update the target package to the fully qualified name from the tap.
        target_package="shivammathur/php/php@$requested_version"

        # Check if the formula exists in the tap.
        if ! brew info "$target_package" &>/dev/null; then
            echo_error "Formula php@$requested_version not found in shivammathur/php tap either."
            echo_error "Please specify an available PHP version."
            exit 1
        fi
    fi

    echo_message "Attempting to install $target_package..."

    # 1. Check if already installed
    if brew list "$target_package" >/dev/null 2>&1; then
        echo "Package $target_package is already installed." >&2
    else
        # 2. Install the package
        echo_message "Installing $target_package via Homebrew..."
        if ! brew install "$target_package"; then
            echo_error "Failed to install $target_package via Homebrew."
            exit 1
        fi
        echo_message "$target_package installed successfully!"
    fi

    # If interactive, ask the user if they want to switch. Otherwise, switch automatically.
    if [ -t 0 ]; then
        read -p "Would you like to switch to PHP $requested_version now? (y/N) " -n 1 -r REPLY
        echo # Move to a new line
        if [[ "$REPLY" =~ ^[Yy]$ ]]; then
            command_use "$requested_version"
        fi
    else
        echo_message "Non-interactive mode detected. Switching to PHP $requested_version automatically."
        command_use "$requested_version" --quiet
    fi
}

command_use_linux() {
    local requested_version="$1"

    # --- Version Auto-Detection ---
    if [ -z "$requested_version" ]; then
        echo_message "Version argument missing, attempting auto-detection..."
        if ! requested_version=$(detect_version); then
            echo_error "PHP version not specified and could not be detected automatically."
            echo "Usage: phpswitcher use [<version>]"
            exit 1
        fi
    fi

    # --- Version Validation ---
    if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
        echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
        exit 1
    fi

    local target_php_binary="/usr/bin/php$requested_version"
    echo_message "Attempting to switch to $target_php_binary..."

    # 1. Check if target version is installed
    if ! [ -f "$target_php_binary" ]; then
        echo_error "Target PHP version $requested_version does not appear to be installed at $target_php_binary."
        echo "Please run \`phpswitcher install $requested_version\` first."
        exit 1
    fi
    echo_message "PHP $requested_version is installed."

    # 2. Switch php and the related build tools in one sudo invocation.
    local alt_script tool tool_bin sudo_args
    alt_script="set -e; update-alternatives --set php $(printf '%q' "$target_php_binary")"
    for tool in phpize php-config phar phpdbg; do
        tool_bin="/usr/bin/${tool}${requested_version}"
        if [ -e "$tool_bin" ]; then
            alt_script+="; update-alternatives --set $(printf '%q' "$tool") $(printf '%q' "$tool_bin") || true"
        fi
    done

    if [ "$PHPSWITCHER_QUIET" = "true" ]; then
        sudo_args=(sudo -n)
    else
        sudo_args=(sudo)
    fi

    echo_message "Switching active PHP version..."
    if "${sudo_args[@]}" sh -c "$alt_script"; then
        mkdir -p "$PHPSWITCHER_DIR"
        echo "$requested_version" > "$PHPSWITCHER_DIR/active_version"
        echo_message "Successfully switched to PHP $requested_version!"
        echo_message "Run 'php --version' to verify."
    elif [ "$PHPSWITCHER_QUIET" = "true" ]; then
        echo_error "Could not switch to PHP $requested_version without a password. Run: phpswitcher use $requested_version"
        exit 1
    else
        echo_error "Failed to switch to PHP $requested_version using update-alternatives."
        echo "You may need to configure it manually:"
        echo "  sudo update-alternatives --config php"
        exit 1
    fi
}

command_install_linux() {
    local requested_version="$1"

    # --- Version Auto-Detection (similar to 'use' command) ---
    if [ -z "$requested_version" ]; then
        echo_message "Version argument missing, attempting auto-detection..."
        if ! requested_version=$(detect_version); then
            echo_error "PHP version not specified and could not be detected automatically."
            echo "Usage: phpswitcher install [<version>]"
            exit 1
        fi
    fi

    # --- Version Validation ---
    if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
        echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
        exit 1
    fi

    local target_package="php$requested_version"
    echo_message "Attempting to install $target_package..."

    # 1. Check if add-apt-repository is installed
    if ! command -v add-apt-repository >/dev/null 2>&1; then
        echo_error "The command 'add-apt-repository' is required but not found."
        echo "Please install it, usually via the 'software-properties-common' package:"
        echo "  sudo apt-get update"
        echo "  sudo apt-get install software-properties-common"
        exit 1
    fi

    # 2. Add the PPA
    echo_message "Adding ppa:ondrej/php..."
    sudo add-apt-repository -y ppa:ondrej/php

    # 3. Update package list
    echo_message "Updating package list..."
    sudo apt-get update

    # 4. Install the package
    echo_message "Installing $target_package..."
    if ! sudo apt-get install -y "$target_package"; then
        echo_error "Failed to install $target_package via apt-get."
        exit 1
    fi
    echo_message "$target_package installed successfully!"

    # If interactive, ask the user if they want to switch. Otherwise, switch automatically.
    if [ -t 0 ]; then
        read -p "Would you like to switch to PHP $requested_version now? (y/N) " -n 1 -r REPLY
        echo # Move to a new line
        if [[ "$REPLY" =~ ^[Yy]$ ]]; then
            command_use "$requested_version"
        fi
    else
        echo_message "Non-interactive mode detected. Switching to PHP $requested_version automatically."
        command_use "$requested_version" --quiet
    fi
}

command_use() {
    if [ "$OS" = "macos" ]; then
        command_use_macos "$@"
    elif [ "$OS" = "linux" ]; then
        command_use_linux "$@"
    else
        echo_error "The 'use' command is not supported on this OS."
        exit 1
    fi
}

# --- Uninstall Command ---

command_uninstall_macos() {
    local requested_version="$1"

    if [ -z "$requested_version" ]; then
        echo_error "Please specify a PHP version to uninstall."
        echo "Usage: phpswitcher uninstall <version>"
        exit 1
    fi

    # --- Version Validation ---
    if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
        echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
        exit 1
    fi

    local target_package="php@$requested_version"

    # Check if installed
    if ! brew list "$target_package" >/dev/null 2>&1; then
        echo_error "PHP version $requested_version is not installed via Homebrew."
        exit 1
    fi

    # Check if this is the active version
    local active_version=""
    local php_link
    php_link=$(readlink "$(brew --prefix)/bin/php" 2>/dev/null || echo "")
    if [[ "$php_link" =~ php@([0-9]+\.[0-9]+) ]]; then
        active_version="${BASH_REMATCH[1]}"
    fi

    if [ "$requested_version" == "$active_version" ]; then
        echo_error "Cannot uninstall PHP $requested_version because it is the currently active version."
        echo "Please switch to a different version first with: phpswitcher use <other-version>"
        exit 1
    fi

    # Confirm if interactive
    if [ -t 0 ]; then
        read -p "Are you sure you want to uninstall PHP $requested_version? (y/N) " -n 1 -r REPLY
        echo
        if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            return
        fi
    fi

    echo_message "Uninstalling $target_package..."
    if brew uninstall "$target_package"; then
        echo_message "PHP $requested_version has been uninstalled successfully."
    else
        echo_error "Failed to uninstall $target_package."
        exit 1
    fi
}

command_uninstall_linux() {
    local requested_version="$1"

    if [ -z "$requested_version" ]; then
        echo_error "Please specify a PHP version to uninstall."
        echo "Usage: phpswitcher uninstall <version>"
        exit 1
    fi

    # --- Version Validation ---
    if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
        echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
        exit 1
    fi

    local target_package="php$requested_version"

    # Check if installed
    if ! dpkg -l "$target_package" 2>/dev/null | grep -q "^ii"; then
        echo_error "PHP version $requested_version is not installed."
        exit 1
    fi

    # Check if this is the active version
    local active_php_path
    active_php_path=$(readlink -f /etc/alternatives/php 2>/dev/null || echo "")
    if [[ "$active_php_path" =~ php${requested_version}$ ]]; then
        echo_error "Cannot uninstall PHP $requested_version because it is the currently active version."
        echo "Please switch to a different version first with: phpswitcher use <other-version>"
        exit 1
    fi

    # Confirm if interactive
    if [ -t 0 ]; then
        read -p "Are you sure you want to uninstall PHP $requested_version? (y/N) " -n 1 -r REPLY
        echo
        if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            return
        fi
    fi

    echo_message "Uninstalling $target_package and related packages..."
    if sudo apt-get remove -y "$target_package" "php${requested_version}-"*; then
        echo_message "PHP $requested_version has been uninstalled successfully."
    else
        echo_error "Failed to uninstall $target_package."
        exit 1
    fi
}

command_uninstall() {
    if [ "$OS" = "macos" ]; then
        command_uninstall_macos "$@"
    elif [ "$OS" = "linux" ]; then
        command_uninstall_linux "$@"
    else
        echo_error "The 'uninstall' command is not supported on this OS."
        exit 1
    fi
}

command_install() {
    if [ "$OS" = "macos" ]; then
        command_install_macos "$@"
    elif [ "$OS" = "linux" ]; then
        command_install_linux "$@"
    else
        echo_error "The 'install' command is not supported on this OS."
        exit 1
    fi
}

# --- Default Command ---

command_default() {
    local default_version_file="$PHPSWITCHER_DIR/default_version"

    if [ "${1:-}" == "--unset" ]; then
        if [ -f "$default_version_file" ]; then
            rm -f "$default_version_file"
            echo_message "Global default PHP version has been unset."
        else
            echo "No global default version is set."
        fi
        return
    fi

    local requested_version="${1:-}"

    if [ -z "$requested_version" ]; then
        # Show current default
        if [ -f "$default_version_file" ]; then
            echo "Global default PHP version: $(cat "$default_version_file")"
        else
            echo "No global default PHP version is set."
            echo "Usage: phpswitcher default <version>"
        fi
        return
    fi

    # Validate version format
    if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
        echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
        exit 1
    fi

    echo "$requested_version" > "$default_version_file"
    echo_message "Global default PHP version set to $requested_version."
    echo "This version will be used when no .php-version file or composer.json is found."
}

# --- Status Command ---

# Report whether the user's shell profile sources the auto-switch hook.
shell_integration_status() {
    local shell_name profile needle

    shell_name=$(basename "${SHELL:-}")
    case "$shell_name" in
        bash)
            if [ -f "$HOME/.bashrc" ]; then
                profile="$HOME/.bashrc"
            else
                profile="$HOME/.bash_profile"
            fi
            needle="phpswitcher-init.sh"
            ;;
        zsh)
            profile="$HOME/.zshrc"
            needle="phpswitcher-init.sh"
            ;;
        fish)
            profile="$HOME/.config/fish/conf.d/phpswitcher.fish"
            needle="phpswitcher-init.fish"
            ;;
        *)
            echo ""
            echo "Shell integration:  not checked (unsupported shell: ${SHELL:-unknown})"
            return
            ;;
    esac

    echo ""
    echo "Shell integration:  $profile"
    if [ -f "$profile" ] && grep -q "$needle" "$profile"; then
        echo "  enabled"
    else
        echo "  not installed"
        echo "  Auto-switch runs only after the shell hook is sourced."
        if [ "$shell_name" = "fish" ]; then
            echo "  Re-run the installer, or add: source \"\$PHPSWITCHER_DIR/phpswitcher-init.fish\""
        else
            echo "  Re-run the installer, or add: source \"\$PHPSWITCHER_DIR/phpswitcher-init.sh\""
        fi
    fi
}

command_status() {
    echo "PHP Switcher Status"
    echo "==================="

    # 1. Active PHP version
    local active_version=""
    local active_version_file="$PHPSWITCHER_DIR/active_version"
    if [ -f "$active_version_file" ]; then
        active_version=$(tr -d '[:space:]' < "$active_version_file")
    fi

    local php_path=""
    local php_reported_version=""
    if command -v php >/dev/null 2>&1; then
        php_path=$(command -v php)
        php_reported_version=$(php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;' 2>/dev/null || echo "unknown")
    fi

    echo ""
    echo "Active PHP version: ${active_version:-unknown}"
    if [ -n "$php_reported_version" ]; then
        echo "PHP reports version: $php_reported_version"
    fi
    if [ -n "$php_path" ]; then
        echo "PHP binary path:    $php_path"
    else
        echo "PHP binary path:    (not found in PATH)"
    fi

    # 2. php.ini path
    if command -v php >/dev/null 2>&1; then
        local ini_path
        ini_path=$(php -r 'echo php_ini_loaded_file();' 2>/dev/null || echo "")
        if [ -n "$ini_path" ]; then
            echo "Loaded php.ini:     $ini_path"
        fi
    fi

    # 3. Detection source for current directory
    echo ""
    echo "Version detection for current directory:"

    local info detected_ver detected_source
    if info=$(detect_version_info); then
        detected_ver=${info%%$'\t'*}
        detected_source=${info#*$'\t'}
        echo "  Detected version: $detected_ver"
        echo "  Source:           $detected_source"
    else
        echo "  No version detected (no .php-version, composer.json, or default set)"
    fi

    # 4. Default version
    echo ""
    local default_version_file="$PHPSWITCHER_DIR/default_version"
    if [ -f "$default_version_file" ]; then
        echo "Global default:     $(tr -d '[:space:]' < "$default_version_file")"
    else
        echo "Global default:     (not set)"
    fi

    shell_integration_status
}

# --- Extensions Command ---

command_extensions_list() {
    local requested_version="$1"

    if [ "$OS" = "macos" ]; then
        echo_message "Installed extensions for PHP $requested_version:"
        local php_bin
        php_bin="$(brew --prefix)/opt/php@$requested_version/bin/php"
        if [ ! -x "$php_bin" ]; then
            echo_error "PHP $requested_version does not appear to be installed."
            exit 1
        fi
        "$php_bin" -m 2>/dev/null | tail -n +2
    elif [ "$OS" = "linux" ]; then
        echo_message "Installed extensions for PHP $requested_version:"
        local php_bin="/usr/bin/php$requested_version"
        if [ ! -x "$php_bin" ]; then
            echo_error "PHP $requested_version does not appear to be installed."
            exit 1
        fi
        "$php_bin" -m 2>/dev/null | tail -n +2
    fi
}

command_extensions_install() {
    local extension="$1"
    local requested_version="$2"

    if [ "$OS" = "macos" ]; then
        echo_message "Installing $extension for PHP $requested_version via PECL..."
        local pecl_bin
        pecl_bin="$(brew --prefix)/opt/php@$requested_version/bin/pecl"
        if [ ! -x "$pecl_bin" ]; then
            echo_error "PECL not found for PHP $requested_version. Is it installed?"
            exit 1
        fi
        if "$pecl_bin" install "$extension"; then
            echo_message "Extension $extension installed successfully for PHP $requested_version."
        else
            echo_error "Failed to install extension $extension."
            exit 1
        fi
    elif [ "$OS" = "linux" ]; then
        local target_package="php${requested_version}-${extension}"
        echo_message "Installing $target_package via apt..."
        if sudo apt-get install -y "$target_package"; then
            echo_message "Extension $extension installed successfully for PHP $requested_version."
        else
            echo_error "Failed to install $target_package. Try checking available packages with: apt-cache search php${requested_version}-"
            exit 1
        fi
    fi
}

command_extensions() {
    local subcommand="${1:-}"
    shift || true

    case "$subcommand" in
        install)
            local extension="${1:-}"
            if [ -z "$extension" ]; then
                echo_error "Please specify an extension to install."
                echo "Usage: phpswitcher extensions install <extension> [<version>]"
                exit 1
            fi
            local requested_version="${2:-}"
            if [ -z "$requested_version" ]; then
                # Try to detect or use active version
                local active_version_file="$PHPSWITCHER_DIR/active_version"
                if [ -f "$active_version_file" ]; then
                    requested_version=$(cat "$active_version_file")
                fi
                if [ -z "$requested_version" ]; then
                    echo_error "Could not determine PHP version. Please specify: phpswitcher extensions install <extension> <version>"
                    exit 1
                fi
                echo_message "Using active PHP version $requested_version."
            fi
            if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
                echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
                exit 1
            fi
            command_extensions_install "$extension" "$requested_version"
            ;;
        ""|list)
            # If subcommand is "list", shift and get version; if empty, get version from $1
            local requested_version="${1:-}"
            if [ -z "$requested_version" ]; then
                local active_version_file="$PHPSWITCHER_DIR/active_version"
                if [ -f "$active_version_file" ]; then
                    requested_version=$(cat "$active_version_file")
                fi
                if [ -z "$requested_version" ]; then
                    echo_error "Could not determine PHP version. Please specify: phpswitcher extensions [list] <version>"
                    exit 1
                fi
                echo_message "Using active PHP version $requested_version."
            fi
            if ! [[ "$requested_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
                echo_error "Invalid version format: \"$requested_version\". Please use format X.Y (e.g., 7.4, 8.1)."
                exit 1
            fi
            command_extensions_list "$requested_version"
            ;;
        *)
            # Could be a version number directly (e.g., phpswitcher extensions 8.1)
            if [[ "$subcommand" =~ ^[0-9]+\.[0-9]+$ ]]; then
                command_extensions_list "$subcommand"
            else
                echo_error "Unknown extensions subcommand: $subcommand"
                echo "Usage: phpswitcher extensions [list] [<version>]"
                echo "       phpswitcher extensions install <extension> [<version>]"
                exit 1
            fi
            ;;
    esac
}

command_help() {
    echo "phpswitcher - A simple CLI to manage multiple PHP versions."
    echo ""
    echo "Usage: phpswitcher <command> [<args>]"
    echo ""
    echo "Available commands:"
    echo "  install [<version>]    Install a specific PHP version (e.g., 8.1)."
    echo "                         If <version> is omitted, it detects from .php-version, composer.json"
    echo "                         (config.platform.php, then require.php, walking parent directories), or default."
    echo "  uninstall <version>    Uninstall a specific PHP version (e.g., 7.4)."
    echo "                         The currently active version cannot be uninstalled."
    echo "  use [<version>]        Switch the active PHP version."
    echo "                         If <version> is omitted, it detects from .php-version, composer.json"
    echo "                         (config.platform.php, then require.php, walking parent directories), or default."
    echo "  list                   List all installed PHP versions and show the active one."
    echo "  default [<version>]    Set or show the global default PHP version."
    echo "                         Use --unset to remove the default."
    echo "  status                 Show current PHP version, detection source, and path info."
    echo "  extensions [<version>] List installed PHP extensions for a version."
    echo "  extensions install <ext> [<version>]"
    echo "                         Install a PHP extension (e.g., xdebug)."
    echo "  self-update            Update phpswitcher to the latest version."
    echo "  version                Show the currently installed version of phpswitcher."
    echo "  help                   Show this help message."
    echo ""
    echo "Platform Support:"
    echo "  - macOS: Uses Homebrew to install and switch PHP versions (php@x.y)."
    echo "  - Linux (Debian/Ubuntu): Uses APT with ppa:ondrej/php. Requires 'sudo' for installation and switching."
    echo ""
    echo "Examples:"
    echo "  phpswitcher install 8.1"
    echo "  phpswitcher uninstall 7.4"
    echo "  phpswitcher use 7.4"
    echo "  cd my-project/ && phpswitcher use"
    echo "  phpswitcher default 8.2"
    echo "  phpswitcher status"
    echo "  phpswitcher extensions 8.1"
    echo "  phpswitcher extensions install xdebug"
    echo "  phpswitcher self-update"
    echo "  phpswitcher version"
}

# --- Main Dispatcher ---
main() {
    detect_os # Detect the OS first

    # Process arguments, extracting --quiet if it exists
    local args=()
    export PHPSWITCHER_QUIET="false"
    for arg in "$@"; do
        if [ "$arg" == "--quiet" ]; then
            export PHPSWITCHER_QUIET="true"
        else
            args+=("$arg")
        fi
    done
    # Set the positional parameters to the new argument list
    set -- "${args[@]}"

    # Run update check in the background. Pass the first argument to it.
    check_for_updates "$1" &

    local command="$1"
    shift || true # Shift off the command, ignore error if no args

    case "$command" in
        use)
            command_use "$@"
            ;;
        install)
            command_install "$@"
            ;;
        uninstall)
            command_uninstall "$@"
            ;;
        list)
            command_list
            ;;
        default)
            command_default "$@"
            ;;
        status)
            command_status
            ;;
        extensions)
            command_extensions "$@"
            ;;
        self-update)
            command_self_update "$@"
            ;;
        -v|--version|version)
            command_version
            ;;
        -h|--help|help)
            command_help
            ;;
        "")
            command_help
            exit 0
            ;;
        *)
            echo_error "Unknown command: $command"
            command_help
            exit 1
            ;;
    esac
}

main "$@"
